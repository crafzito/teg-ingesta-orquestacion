# Backend API (FastAPI SQL Explorer)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sap_etl
DB_USER=postgres
DB_PASSWORD=postgres

# ETL Pipeline (etl/pipeline.py)
# PG_DSN se construye a partir de las variables de arriba, o se puede sobreescribir:
# PG_DSN=host=localhost dbname=sap_etl user=postgres password=postgres

# Directorio de CSVs de SAP
SAP_CSV_DIR=data/input
